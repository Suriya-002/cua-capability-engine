# Copy to .env — never commit .env
ANTHROPIC_API_KEY=sk-ant-...
CUA_MODEL=claude-sonnet-5
CUA_EFFORT=medium
CUA_POLICY_PATH=policies/default.yaml
CUA_EVIDENCE_DIR=evidence
CUA_MOCKBANK_URL=http://localhost:7860/bank
CUA_HEADLESS=false   # true in CI; attended runs are always headed regardless
# Comma-separated literal values that must never appear in evidence (canary test uses this too)
CUA_REDACT_LITERALS=
# Token required to trigger LLM discovery through the HTTP API (leave empty to disable the endpoint)
CUA_DISCOVERY_TOKEN=
CUA_DISCOVERY_DAILY_CAP=5
# Operator credentials for the target app. Referenced by artifacts as ${secrets.username} / ${secrets.password};
# never written to artifacts or evidence. (These are the mock bank's synthetic demo values.)
CUA_SECRET_USERNAME=svc_automation_7f3
CUA_SECRET_PASSWORD=Lcu-demo-9x2Q
